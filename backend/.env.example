# SMTP settings used by the backend email service
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
FRONTEND_URL=http://localhost:3000

# Public contact form destination. Keep this server-side only.
CONTACT_RECIPIENT_EMAIL=kalora.support.admin@gmail.com

# Comma-separated frontend origins allowed by the backend.
# Set this to the deployed KALORA frontend origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
